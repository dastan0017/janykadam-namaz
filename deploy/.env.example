# Настройки прод-стенда. Скопируйте в deploy/.env и заполните.
# Файл с настоящими значениями в git не попадает.

# Домен, на котором живут и панель, и API. Без схемы.
# Заведён на DuckDNS, TTL 60 секунд — смена IP расходится за минуту.
DOMAIN=janykadam.duckdns.org

# Адрес, на который Caddy берёт сертификат. Обычно совпадает с DOMAIN.
# Для проверки без домена поставьте :80 — тогда TLS не включается.
SITE_ADDRESS=janykadam.duckdns.org

# Username бота без @. Нужен виджету входа в панель.
# В BotFather для DOMAIN обязателен /setdomain, иначе виджет не отдаст данные.
BOT_USERNAME=janykadam_bot

# Токен из BotFather.
BOT_TOKEN=

# Секреты: каждый — openssl rand -hex 32
POSTGRES_PASSWORD=
WEBHOOK_SECRET=
SESSION_SECRET=

# Кого сид сделает первым админом панели. Без @.
INITIAL_ADMIN_TG_USERNAME=

LOG_LEVEL=info
