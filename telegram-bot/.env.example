# Процесс обязан работать в UTC: на этом держится весь расчёт времени.
TZ=UTC
NODE_ENV=development

# BotFather
BOT_TOKEN=123456:AA...

# polling в разработке, webhook в проде
BOT_MODE=polling
# PUBLIC_URL=https://bot.example.com
# WEBHOOK_SECRET=  # openssl rand -hex 32

DATABASE_URL=postgres://janykadam:janykadam@localhost:5432/janykadam

SESSION_SECRET=   # openssl rand -hex 32
ADMIN_ORIGIN=http://localhost:5173

INITIAL_ADMIN_TG_USERNAME=your_username
SEED_DEMO=true

PORT=3000
LOG_LEVEL=debug
