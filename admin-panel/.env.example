# Адрес бэкенда. Пустая строка — тот же origin, что и панель.
# Кука сессии ставится с SameSite=Lax, поэтому панель и API должны быть на одном
# сайте: localhost с разными портами — это один сайт, а вот panel.netlify.app и
# api.example.com — разные, там понадобится SameSite=None; Secure.
VITE_API_URL=http://localhost:3000

# Username бота без @ — нужен виджету входа Telegram.
# В BotFather для домена панели обязателен /setdomain, иначе виджет не отдаст данные.
VITE_BOT_USERNAME=janykadam_bot

# true — работать на локальных фикстурах, без бэкенда. Ничего не сохраняется.
VITE_USE_SEED=false
